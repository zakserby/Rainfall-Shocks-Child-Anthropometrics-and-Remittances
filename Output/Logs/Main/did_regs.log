. * b. Event-study TWFE DID. Note that Event time: 2002 = -2 is lead, 2005 = -1
>  is reference, 2009 = 0 is treatment period
. gen lead_2_treat = treat2009 * (year == 2002)
(25,453 missing values generated)

. gen lag_0_treat  = treat2009 * (year == 2009)
(25,453 missing values generated)

. 
. * Model 3 and Model 5 children, so the event studies use the same children as
>  the DID tables
. foreach v in haz waz bmiz {
  2.     quietly reghdfe `v' treat_post $did_controls $controls02 $controls05 i
> f s_`v' == 1, absorb($FE_month) vce(cluster cvegeo05)
  3.     gen tmp = e(sample)
  4.     bysort pid_link_canonical: egen m3_`v' = max(tmp)
  5.     drop tmp
  6.     quietly reghdfe `v' treat_post remittance_hh_02_post treat_post_remit0
> 2 $did_controls $controls02 $controls05 if s_`v' == 1, absorb($FE_month) vce(
> cluster cvegeo05)
  7.     gen tmp = e(sample)
  8.     bysort pid_link_canonical: egen m5_`v' = max(tmp)
  9.     drop tmp
 10. }

. 
. foreach v in haz waz bmiz {
  2.     * We restrict to the Model 3 children
.     reghdfe `v' lead_2_treat lag_0_treat if e_`v' == 1 & m3_`v' == 1, absorb(
> $FE_month) vce(cluster cvegeo05)
  3.     * Here we conduct a pretrend test where we expect lead to be around 0
.     test lead_2_treat
  4. 
.     * Save coefficients and CIs for plotting, the reference period is posted 
> as 0
.     preserve
  5.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_`v'.dta", replace
  6.     post handle (-2) (_b[lead_2_treat]) (_se[lead_2_treat]) (_b[lead_2_tre
> at] - 1.96*_se[lead_2_treat]) (_b[lead_2_treat] + 1.96*_se[lead_2_treat])
  7.     post handle (-1) (0) (0) (0) (0)
  8.     post handle (0) (_b[lag_0_treat]) (_se[lag_0_treat]) (_b[lag_0_treat] 
> - 1.96*_se[lag_0_treat]) (_b[lag_0_treat] + 1.96*_se[lag_0_treat])
  9.     postclose handle
 10. 
.     * Plot the event study coefficients
.     use "$out_regs/Appendix/es_`v'.dta", clear
 11.     sort etime
 12.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("Event study: `v'") legend(off)
 13.     * Saved to the Figures folder
.     graph export "$out_figs/Miscellaneous/event_study_`v'.png", replace
 14.     restore
 15. }
