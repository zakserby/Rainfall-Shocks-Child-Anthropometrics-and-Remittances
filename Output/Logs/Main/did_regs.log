.     do "$scripts/Regressions/DID_Regs.do" 

. *******************************************************************
. * DID: Drought between MxFLS-2 and MxFLS-3 and child health
. * Project: MS Thesis
. *******************************************************************
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global raw_mxfls     "$root/Data/Raw/MxFLS"

. global raw_who       "$root/Data/Raw/WHO_reference"

. global clean_mxfls   "$root/Data/Cleaned/MxFLS"

. global clean_who     "$root/Data/Cleaned/WHO_zscores"

. global clean_rain    "$root/Data/Cleaned/Rainfall"

. global clean_banxico "$root/Data/Cleaned/Banxico"

. global out_sumstats  "$root/Output/Tables"

. global out_regs      "$root/Output/Regression_Estimates"

. global out_logs      "$root/Output/Logs"

. global out_figs      "$root/Output/Figures"

. capture mkdir "$out_figs"

. * Create the folders this project writes to. Note: capture skips quietly if a
>  folder already exists)
. foreach d in "$root/Data" "$root/Data/Cleaned" "$clean_mxfls" "$clean_who" "$
> clean_rain" "$root/Output" "$out_sumstats" "$out_regs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. foreach d in "$out_regs" "$out_logs" "$out_figs" {
  2.     foreach s in Main Appendix {
  3.         capture mkdir "`d'/`s'"
  4.     }
  5. }

. capture mkdir "$out_figs/Miscellaneous"

. 
. * If the master already opened the log, the capture fails quietly and the mas
> ter keeps logging. If this file is run on its own, it opens the same log here
>  and closes it at the end, so the DID and the event study are always in the l
> og.
. capture log using "$out_logs/Main/did_regs.log", replace text name(regs_did)

. local own_log = (_rc == 0)

. 
. *******************************************************************
. * Load DID analysis data
. *******************************************************************
. 
. * Loading in data
. use "$clean_mxfls/mxfls_did_analysis.dta", clear
(ENNVIH-3 Libro s_sa)

. 
. 
. *******************************************************************
. * Fixed Effects & Controls
. *******************************************************************
. 
. global FE_did "pid_link_canonical year"

. * Child FE and interview year-month FE, so treated and control children measu
> red in the same month are compared. 
. global FE_month "pid_link_canonical int_ym"

. * Controls for other droughts. Must be interacted with post
. global did_controls "drought2005_post drought2006_post drought2007_post droug
> ht2008_post"

. * Baseline 2002 household controls. Must be interacted with post
. global controls02 "dwell_electricity_02_post dwell_floor_good_02_post dwell_r
> oof_good_02_post dwell_ventilation_good_02_post rooms_per_person_02_post ln_p
> c_expend_month_02_post rural_02_post"

. * Child and mother 2005 controls. Must be interacted with post. These are fil
> led for about 95% of the DID children
. global controls05 "child_male_05_post mother_height_cm_05_post mother_edu_yea
> rs_05_post mother_age_at_birth_05_post mother_employed_05_post fully_vaccinat
> ed_05_post"

. * Father and Book IV birth controls 2005. Must be interacted with post. Only 
> filled for about 65% to 80% of the DID children so we keep them separate
. global controls05_birth "father_height_cm_05_post father_edu_years_05_post fa
> ther_age_at_birth_05_post father_employed_05_post birth_order_05_post oldest_
> child_05_post birth_weight_kg_05_post delivered_home_05_post predominant_brea
> stfed_05_post iron_pregnancy_05_post premature_05_post"

. 
. *******************************************************************
. * DID regressions: 2009 drought
. *******************************************************************
. 
. * reghdfe needed for absorbing fixed effects; install once if not already pre
> sent
. capture which reghdfe

. if _rc ssc install reghdfe

. capture which ftools

. if _rc ssc install ftools

. capture which require

. if _rc ssc install require

. capture which boottest

. if _rc ssc install boottest

. 
. * NOTE: Standard errors are clustered at the 2005 municipality, where treatme
> nt is assigned. STILL IN PROCESS OF THINKING ABOUT CVEOGEO INSTEAD OF CVEOGEO
> 05. Reasoning for 2005 is because cveogeo changes for movers and thus the clu
> sters would not stay fixed over time
. 
