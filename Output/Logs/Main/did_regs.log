. *******************************************************************
. * Parallel trends and event study
. *******************************************************************
. 
. * Event study sample. Here we use the same restrictions as the main DID, but 
> all three waves
. * e_haz, e_waz and e_bmiz are now built in Build_DID_Analysis_Data.do
. 
. * a. Average outcome by wave for treated and control, just a simple parallel 
> trends
. foreach v in haz waz bmiz {
  2.     preserve
  3.     keep if e_`v' == 1
  4.     collapse (mean) `v', by(treat2009 year)
  5.     twoway ///
>         (connected `v' year if treat2009 == 0, mc(navy) lc(navy) ms(O)) ///
>         (connected `v' year if treat2009 == 1, mc(cranberry) lc(cranberry) ms
> (T)), ///
>         xline(2009, lp(dash) lc(black)) ///
>         xlabel(2002 2005 2009) ///
>         legend(order(1 "Control" 2 "Treated (2009 drought)") pos(6) row(1)) /
> //
>         xtitle("Wave") ytitle("Mean `v'") ///
>         title("Mean `v' by wave, treated vs control")
  6.     * Saved to the Figures folder
.     graph export "$out_figs/Miscellaneous/trends_`v'.png", replace
  7.     restore
  8. }
