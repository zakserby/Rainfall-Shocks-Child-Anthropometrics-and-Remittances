. 
. * Parallel trends graph and event study for the children in all 3 waves
. foreach v in haz waz bmiz {
  2.     preserve
  3.     keep if e_`v'_all3 == 1
  4.     collapse (mean) `v', by(treat2009 year)
  5.     twoway ///
>         (connected `v' year if treat2009 == 0, mc(navy) lc(navy) ms(O)) ///
>         (connected `v' year if treat2009 == 1, mc(cranberry) lc(cranberry) ms
> (T)), ///
>         xline(2009, lp(dash) lc(black)) ///
>         xlabel(2002 2005 2009) ///
>         legend(order(1 "Control" 2 "Treated (2009 drought)") pos(6) row(1)) /
> //
>         xtitle("Wave") ytitle("Mean `v'") ///
>         title("Mean `v' by wave, children in all 3 waves")
  6.     graph export "$out_figs/Appendix/trends_`v'_all3.png", replace
  7.     restore
  8. 
.     reghdfe `v' lead_2_treat lag_0_treat if e_`v'_all3 == 1, absorb($FE_month
> ) vce(cluster cvegeo05) 
  9.     * Pre-trend test: lead should be about 0
.     test lead_2_treat
 10. 
.     * Save coefficients and CIs for plotting, the reference period is posted 
> as 0
.     preserve
 11.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_`v'_all3.dta", replace
 12.     post handle (-2) (_b[lead_2_treat]) (_se[lead_2_treat]) (_b[lead_2_tre
> at] - 1.96*_se[lead_2_treat]) (_b[lead_2_treat] + 1.96*_se[lead_2_treat])
 13.     post handle (-1) (0) (0) (0) (0)
 14.     post handle (0) (_b[lag_0_treat]) (_se[lag_0_treat]) (_b[lag_0_treat] 
> - 1.96*_se[lag_0_treat]) (_b[lag_0_treat] + 1.96*_se[lag_0_treat])
 15.     postclose handle
 16. 
.     * Plot the event-study coefficients
.     use "$out_regs/Appendix/es_`v'_all3.dta", clear
 17.     sort etime
 18.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("Event study, children in all 3 waves: `v'") legend(off)
 19.     * Saved to the Figures folder
.     graph export "$out_figs/Appendix/event_study_`v'_all3.png", replace
 20.     restore
 21. }
