. * Event study by SPI class, near normal is the reference and wet municipaliti
> es (z >= 1) are dropped like add_spi() in functions.R. * Note: We don't use c
> ontrols. This is same as the SPI table. Same children as the SPI table, in ea
> ch wave they are measured, with child and wave FE like its first difference
. gen mod_dry = (rain_z2009 <= -1 & rain_z2009 > -1.5) if rain_z2009 < 1
(28,604 missing values generated)

. gen sev_dry = (rain_z2009 <= -1.5) if rain_z2009 < 1
(28,604 missing values generated)

. gen lead_2_mod = mod_dry * (year == 2002)
(28,604 missing values generated)

. gen lag_0_mod  = mod_dry * (year == 2009)
(28,604 missing values generated)

. gen lead_2_sev = sev_dry * (year == 2002)
(28,604 missing values generated)

. gen lag_0_sev  = sev_dry * (year == 2009)
(28,604 missing values generated)

. * SPI table children
. foreach v in haz waz bmiz {
  2.     bysort pid_link_canonical: egen spi_`v' = max(reg_`v' == 1 & rain_z200
> 9 < 1)
  3. }

. 
. foreach v in haz waz bmiz {
  2.     quietly areg `v' lead_2_mod lag_0_mod lead_2_sev lag_0_sev i.year if e
> _`v' == 1 & spi_`v' == 1, absorb(pid_link_canonical) vce(cluster cvegeo05)
  3.     boottest lead_2_mod, reps(9999) weighttype(webb) seed(1234) nograph
  4.     boottest lead_2_sev, reps(9999) weighttype(webb) seed(1234) nograph
  5.     reghdfe `v' lead_2_mod lag_0_mod lead_2_sev lag_0_sev if e_`v' == 1 & 
> spi_`v' == 1, absorb(pid_link_canonical year) vce(cluster cvegeo05)
  6. 
.     * The two classes are moved a little left and right of each wave so their
>  CIs don't overlap
.     preserve
  7.     postfile handle str3 cls double etime b se lb ub using "$out_regs/Main
> /es_severity_`v'.dta", replace
  8.     foreach c in mod sev {
  9.         local off = cond("`c'" == "mod", -0.06, 0.06)
 10.         post handle ("`c'") (-2 + `off') (_b[lead_2_`c']) (_se[lead_2_`c']
> ) (_b[lead_2_`c'] - 1.96*_se[lead_2_`c']) (_b[lead_2_`c'] + 1.96*_se[lead_2_`
> c'])
 11.         post handle ("`c'") (-1 + `off') (0) (0) (0) (0)
 12.         post handle ("`c'") (0 + `off') (_b[lag_0_`c']) (_se[lag_0_`c']) (
> _b[lag_0_`c'] - 1.96*_se[lag_0_`c']) (_b[lag_0_`c'] + 1.96*_se[lag_0_`c'])
 13.     }
