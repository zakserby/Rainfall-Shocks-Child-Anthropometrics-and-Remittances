. * c. Triple-difference event study
. * This tests whether children in 2002 remittance households in drought areas 
> were already on a different health path before the 2009 drought. Want to see 
> that the 2002 lead is roughly 0. If 0, then any difference after 2009 can mor
> e credibly be read as remittances buffering the drought, not pre-existing dif
> ferences between remittance and non-remittance families
. 
. gen lead_2_remit = remittance_hh_02 * (year == 2002)
(44,004 missing values generated)

. gen lag_0_remit  = remittance_hh_02 * (year == 2009)
(44,004 missing values generated)

. gen lead_2_ddd   = treat2009 * remittance_hh_02 * (year == 2002)
(44,016 missing values generated)

. gen lag_0_ddd    = treat2009 * remittance_hh_02 * (year == 2009)
(44,016 missing values generated)

. label variable lead_2_ddd "2009 drought x 2002 remittances x 2002 wave (pre-t
> rend lead)"

. label variable lag_0_ddd  "2009 drought x 2002 remittances x 2009 wave (buffe
> r effect)"

. 
. foreach v in haz waz bmiz {
  2.     reghdfe `v' lead_2_ddd lag_0_ddd lead_2_treat lag_0_treat lead_2_remit
>  lag_0_remit if e_`v' == 1 & !missing(remittance_hh_02), absorb($FE_month) vc
> e(cluster cvegeo05)
  3.     * Pre-trend test for the DDD. The lead should be about 0
.     test lead_2_ddd
  4.     lincom lag_0_treat + lag_0_ddd
  5.     * Save the DDD coefficients and CIs for plotting
.     preserve
  6.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_ddd_`v'.dta", replace
  7.     post handle (-2) (_b[lead_2_ddd]) (_se[lead_2_ddd]) (_b[lead_2_ddd] - 
> 1.96*_se[lead_2_ddd]) (_b[lead_2_ddd] + 1.96*_se[lead_2_ddd])
  8.     post handle (-1) (0) (0) (0) (0)
  9.     post handle (0) (_b[lag_0_ddd]) (_se[lag_0_ddd]) (_b[lag_0_ddd] - 1.96
> *_se[lag_0_ddd]) (_b[lag_0_ddd] + 1.96*_se[lag_0_ddd])
 10.     postclose handle
 11.         * Plot the DDD event study coefficients
.     use "$out_regs/Appendix/es_ddd_`v'.dta", clear
 12.     sort etime
 13.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("DDD event study (drought x 2002 remittances): `v'") legend(off
> )
 14.     graph export "$out_figs/Appendix/event_study_ddd_`v'.png", replace
 15.     restore
 16. }
