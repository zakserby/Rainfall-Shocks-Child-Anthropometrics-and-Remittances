> n_pc_expend_month_02_post rural_02_post"

. local cnt_controls05 "child_male_05_post mother_height_cm_05_post mother_edu_
> years_05_post mother_age_at_birth_05_post mother_employed_05_post fully_vacci
> nated_05_post"

. foreach o in haz waz bmiz {
  2.     quietly reghdfe `o' treat_post if s_`o' == 1, absorb(pid_link_canonica
> l int_ym) vce(cluster cvegeo05)
  3.     gen m1_`o' = e(sample)
  4.     quietly reghdfe `o' treat_post `cnt_did_controls' `cnt_controls02' `cn
> t_controls05' if s_`o' == 1, absorb(pid_link_canonical int_ym) vce(cluster cv
> egeo05)
  5.     gen m3_`o' = e(sample)
  6.     quietly reghdfe `o' treat_post remittance_hh_02_post treat_post_remit0
> 2 `cnt_did_controls' `cnt_controls02' `cnt_controls05' if s_`o' == 1, absorb(
> pid_link_canonical int_ym) vce(cluster cvegeo05)
  7.     gen m5_`o' = e(sample)
  8. }

