. *******************************************************************
. * Summary statistics for the 2009 drought DID
. * Project: MS Thesis
. *******************************************************************
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global raw_mxfls     "$root/Data/Raw/MxFLS"

. global raw_who       "$root/Data/Raw/WHO_reference"

. global clean_mxfls   "$root/Data/Cleaned/MxFLS"

. global clean_who     "$root/Data/Cleaned/WHO_zscores"

. global clean_rain    "$root/Data/Cleaned/Rainfall"

. global clean_banxico "$root/Data/Cleaned/Banxico"

. global out_sumstats  "$root/Output/Tables"

. global out_regs      "$root/Output/Regression_Estimates" 

. global out_logs      "$root/Output/Logs"

. 
. * Create the folders this project writes to (capture skips quietly if a folde
> r already exists)
. foreach d in "$root/Data" "$root/Data/Cleaned" "$clean_mxfls" "$clean_who" "$
> clean_rain" "$root/Output" "$out_sumstats" "$out_regs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. * This includes writing to Main and Appendix subfolders, same as 00_Master.do
. foreach d in "$out_sumstats" "$out_regs" "$out_logs" {
  2.     foreach s in Main Appendix {
  3.         capture mkdir "`d'/`s'"
  4.     }
  5. }

. 
. *******************************************************************
. * Some preliminaries
. *******************************************************************
. 
. capture which estpost

. if _rc ssc install estout

. capture which distinct

. if _rc ssc install distinct

. 
. *******************************************************************
. * Load DID analysis data
. *******************************************************************
. 
. * Loading in data
. use "$clean_mxfls/mxfls_did_analysis.dta", clear
(ENNVIH-3 Libro s_sa)

. 
. *******************************************************************
. * DID variables
. *******************************************************************
. 
. * Keep remittances only on the 2005 row, blank on the others
. gen remit05_tmp = remittance_hh if year == 2005
(82,772 missing values generated)

. * Copy that 2005 value to all of the child's rows
. bysort pid_link_canonical: egen remittance_hh_05 = max(remit05_tmp)
(31,971 missing values generated)

. drop remit05_tmp

. 
. gen did_sample = age < 16 & !missing(treat2009) & treat_early == 0

. 
. *******************************************************************
. * Globals
. *******************************************************************
. 
. * Controls. We sort sections by household, child and mother, father and birth
> . Primarily bc father and birth have fewer observations for children and redu
> ce the sample size a lot 
. * Outcomes
. global outcomes "haz waz bmiz"

. * Treatment and the other droughts between the waves
. global treatment "treat2009 drought2005 drought2006 drought2007 drought2008"

. * Remittances
. global remit "remittance_hh_05"

. * Household controls
. global controls_hh "dwell_electricity dwell_floor_good dwell_roof_good dwell_
> ventilation_good rooms_per_person ln_pc_expend_month rural"

. * Child and mother controls
. global controls_child "age child_male fully_vaccinated mother_height_cm mothe
> r_edu_years mother_age_at_birth mother_employed"

. * Father and Book IV birth controls. Note this is filled for fewer children
. global controls_birth "father_height_cm father_edu_years father_age_at_birth 
> father_employed birth_order oldest_child birth_weight_kg delivered_home predo
> minant_breastfed iron_pregnancy premature"

. 
. * All vars
. global baseline_vars "$outcomes $remit $controls_hh $controls_child $controls
> _birth"

. * Table variables as they enter the regressions, so 2002 remittances and hous
> ehold controls, and 2005 child and parent controls
. global remit02 "remittance_hh_02"

. global controls_hh02 "dwell_electricity_02 dwell_floor_good_02 dwell_roof_goo
> d_02 dwell_ventilation_good_02 rooms_per_person_02 ln_pc_expend_month_02 rura
> l_02"

. * Continuous DID treatment
. global contdid_treat "rain_deficit2009 any_deficit2009"

. global table_vars "$treatment $contdid_treat $remit02 $controls_hh02 $control
> s_child $controls_birth"

. 
