. *******************************************************************
. * Balance table of treated vs control
. *******************************************************************
. 
. 
. * reghdfe needed for absorbing fixed effects; install once if not already pre
> sent, same as in DID_Regs
. capture which reghdfe

. if _rc ssc install reghdfe

. capture which ftools

. if _rc ssc install ftools

. capture which require

. if _rc ssc install require

. 
. 
. * This block defines a new Stata command called cnt_row. NOTE: Nothing runs h
> ere, just the template. This program writes one row of the table by 
.         * 1) Counting how many control children, households or municipalities
>  meet a condition
.         * 1) Counting how many treated children, households or municipalities
>  meet a condition
.         * 3) Writes one line of LaTeX into the .tex file that label control c
> ount & treated count.
. * Has about 60 rows, and this is done because more efficient then writing 60 
> times. Only the label and conditions change
. capture program drop cnt_row

. program define cnt_row
  1.     gettoken label 0 : 0
  2.     syntax , Sample(string) Control(string) Treated(string) [Distinct(varn
> ame) Last]
  3.     foreach g in control treated {
  4.                 * Counting Children
.                 * NOTE: Basically box left blank no distinct(...) in the line
>  then the program sees an empty box and counts children, one per row of data.
>  
.         if "`distinct'" == "" {
  5.             quietly count if (`sample') & (``g'')
  6.             local n_`g' = r(N)
  7.         }
  8.                 * Counting municipalities or households
.                 * NOTE: This distinct(...) is filled in with cvegeo05 or foli
> o_canonical  here and specified later down
.         else {
  9.             capture quietly distinct `distinct' if (`sample') & (``g'')
 10.             local n_`g' = cond(_rc, 0, r(ndistinct))
 11.         }
 12.                 * Just formatting
.         local c_`g' : display %12.0fc `n_`g''
 13.         local c_`g' = strtrim("`c_`g''")
 14.     }
 15.     local end "\\*"
 16.         * LaTeX stuff
.     if "`last'" != "" local end "\\"
 17.     file write cnt `"`label' & `c_control' & `c_treated'`end'"' _n
 18.         * Displaying in stata
.     di as text `"`label': "' as result "`c_control' control, `c_treated' trea
> ted"
 19. end

. 
. 
. preserve

. * Run DID Models 1, 3 and 5 of DID_Regs.do, we flag with e(sample), meaning t
> his creates a row with 1's and 0's and the 1's are the observations used in t
> he regression. Then later on in the script we will count these ones to get th
> e sample of treated or control. 
. * Purpose of this block is to find out exactly which children each regression
>  uses
. local cnt_did_controls "drought2005_post drought2006_post drought2007_post dr
> ought2008_post"

. local cnt_controls02 "dwell_electricity_02_post dwell_floor_good_02_post dwel
