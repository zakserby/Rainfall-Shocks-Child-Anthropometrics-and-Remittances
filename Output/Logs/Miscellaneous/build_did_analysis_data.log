. *****************************************************************************
> *****************
. * Community bank/bank branch access in 2002 (still in process of getting it) 
. * would code it similar to remittances
. *****************************************************************************
> ****************
. 
. 
. * We restrict child health outcomes to these two waves 2005 and 2009, age cut
>  offs based on WHO and MxFLS.
. gen s_haz  = inlist(year, 2005, 2009) & age < 16 & treat_early == 0 & !missin
> g(treat2009)

. gen s_waz  = inlist(year, 2005, 2009) & age < 11 & treat_early == 0 & !missin
> g(treat2009)

. gen s_bmiz = inlist(year, 2005, 2009) & age < 16 & treat_early == 0 & !missin
> g(treat2009)

. 
. * Event study sample. Here we use the same restrictions as the main DID, but 
> all three waves
. gen e_haz  = inlist(year, 2002, 2005, 2009) & age < 16 & treat_early == 0 & !
> missing(treat2009)

. gen e_waz  = inlist(year, 2002, 2005, 2009) & age < 11 & treat_early == 0 & !
> missing(treat2009)

. gen e_bmiz = inlist(year, 2002, 2005, 2009) & age < 16 & treat_early == 0 & !
> missing(treat2009)

. 
. * NOTE: THIS IS ONLY USED BY THE SUMMARY STATS. 
. * These are the children reghdfe and contdid use. The samples. LOOSELY DEFINE
> D
. foreach v in haz waz bmiz {
  2.     gen tmp = s_`v' == 1 & !missing(`v')
  3.     bysort pid_link_canonical: egen n_`v' = total(tmp)
  4.     gen reg_`v' = (tmp == 1 & n_`v' == 2)
  5.     drop tmp n_`v'
  6.     label variable reg_`v' "Estimation sample, `v' in both 2005 and 2009"
  7. }

. 
