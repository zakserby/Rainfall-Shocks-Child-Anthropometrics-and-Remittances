.         use "$who_output_dir/mxfls2005_u5_z_rc.dta", clear
(VERSION 7 Aug 2008)

.     * The original ado computes flags but it doesn't implement the flags and 
> remove implausible z-scores, here we implement it
.     gen haz = _zlen if _flen == 0
(222 missing values generated)

.     gen waz = _zwei if _fwei == 0
(32 missing values generated)

.     gen bmiz = _zbmi if _fbmi == 0
(273 missing values generated)

.         * Implement a check to count how many got flagged/excluded as out-of-
> range
.     count if _flen == 1
  10

.     di "u5: `r(N)' HAZ obs flagged out of range (<-6 or >6)"
u5: 10 HAZ obs flagged out of range (<-6 or >6)

.     count if _fwei == 1
  8

.     di "u5: `r(N)' WAZ obs flagged out of range (<-6 or >5)"
u5: 8 WAZ obs flagged out of range (<-6 or >5)

.     count if _fbmi == 1
  37

.     di "u5: `r(N)' BMIZ obs flagged out of range (<-5 or >5)"
u5: 37 BMIZ obs flagged out of range (<-5 or >5)

.     keep folio ls haz waz bmiz

.     save `z_u5'
