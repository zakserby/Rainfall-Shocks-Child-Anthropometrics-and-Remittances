. drop ls04

. 
. *******************************************************************
. * Calcualting HAZ, WAZ, BMIZ
. *******************************************************************
. 
. * Grabbing the date
. rename sa02_1 bday

. rename sa02_2 bmonth

. rename sa02_3 byear

. 
. 
. * This code purely is for the missing "day" observations. It imputes a bday i
> f we have both month and year, this allows us to keep roughly 200 observation
> s for children get z-scores whereas before we dropped them and had no z-score
> s. 
. gen byte bday_imputed = !inrange(bday, 1, 31) & inrange(bmonth, 1, 12) & inra
> nge(byear, 1900, 2007)

. replace bday = 15 if bday_imputed == 1
(569 real changes made)

. 
. * Children are weighed and measured in Book S. We use the last dated Book S v
> isit as the measurement date, day = 15 
. preserve

.     use "$path/hh05dta_bc/c_conpor.dta", clear
(VERSION 15 Jan 2008)

.     keep folio secuencia anio mes

.     sort folio secuencia

.     by folio: keep if _n == _N
(134 observations deleted)

.     gen int_date = mdy(mes, 15, 2000 + anio)

.     keep folio int_date

.     tempfile visitdate

.     save `visitdate'
