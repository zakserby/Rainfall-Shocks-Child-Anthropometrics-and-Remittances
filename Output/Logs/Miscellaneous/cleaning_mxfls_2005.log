.     do "$scripts/Cleaning/Cleaning Script for MxFLS_2005_06.do"

. *******************************************************************
. * Cleaning Script and Initial Sumamry Statistics
. * Project: MS Thesis
. *******************************************************************
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global raw_mxfls     "$root/Data/Raw/MxFLS"

. global raw_who       "$root/Data/Raw/WHO_reference"

. global clean_mxfls   "$root/Data/Cleaned/MxFLS"

. global clean_who     "$root/Data/Cleaned/WHO_zscores"

. global clean_rain    "$root/Data/Cleaned/Rainfall"

. global clean_banxico "$root/Data/Cleaned/Banxico"

. global out_sumstats  "$root/Output/Tables"

. global out_regs      "$root/Output/Regression_Estimates" 

. global out_logs      "$root/Output/Logs"

. * Create the folders this project writes to. Note: capture skips quietly if a
>  folder already exists
. foreach d in "$root/Data" "$root/Data/Cleaned" "$clean_mxfls" "$clean_who" "$
> clean_rain" "$root/Output" "$out_sumstats" "$out_regs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. * Define base directory path
. global path "$raw_mxfls/hh05dta_all"

. 
. *******************************************************************
. * Health Biomarkers & Anthropometrics
. *******************************************************************
. 
. use "$path/hh05dta_bs/s_sa.dta", clear
(VERSION 7 Aug 2008)

. * Note for now not differentiating between reported and measured I don't thin
> k
. rename sa03       age

. rename sa01       gender

. rename sa04_22    height_cm // Revising, but currently not in use

. rename sa05_21    weight_kg_gr

. rename sa12_21    blood_pressure_systole

. rename sa12_22    blood_pressure_diastole

. rename sa16_21    hemoglobin_g_dl

. 
. * Child biomarkers
. rename sa07_21    child_height_cm

. rename sa08_21    child_weight_kg

. 
. * Child sex must come from the Book C roster, ls04, as sex disagrees across o
> ther books but the roster is correct.
. preserve

.     use "$path/hh05dta_bc/c_ls.dta", clear
(VERSION 15 Jan 2008)

.     keep folio ls ls04

.     tempfile roster_sex

.     save `roster_sex'
