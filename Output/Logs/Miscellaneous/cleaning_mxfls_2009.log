> sing "$clean_mxfls/mxfls_`w'_master.dta", clear
  4.         drop if pid_link_canonical == ""
  5.         bysort pid_link_canonical: keep if _N == 1
  6.         foreach v in birth_order oldest_child birth_weight_kg delivered_ho
> me predominant_breastfed still_breastfed iron_pregnancy premature {
