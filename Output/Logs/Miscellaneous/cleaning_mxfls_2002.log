. 
. * IMPORTANT NOTE: THINKING ABOUT ADDING IN AGE AS A CONTROL????
. gen age_days = int_date - mdy(bmonth, bday, byear)
(3,036 missing values generated)

. * Some Book S birth dates are wrong, so the computed age disagrees with the a
> ge reported in Book S (sa03). For these we set age_days to missing so they ge
> t no z-score, same rule as 2009.
. replace age_days = . if !missing(age, age_days) & !inrange(age_days/365.25 - 
> age, -0.5, 1.5)
(2,920 real changes made, 2,920 to missing)

. * The check above stays on the Book C date because the Book S age (sa03) is m
> ostly the roster age from the Book C visit
. replace age_days = meas_date - mdy(bmonth, bday, byear) if !missing(age_days,
>  meas_date)
(3,495 real changes made)

. replace int_date = meas_date if !missing(meas_date)
(4,443 real changes made)

. drop meas_date

. gen age_months_exact = age_days / 30.4375
(5,956 missing values generated)

. sum age_months_exact age_days

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
age_months~t |     26,213    321.1661    239.2431  -4.041068   1290.612
    age_days |     26,213    9775.493    7281.963       -123      39283

. 
. * Just some variable recoding below
. gen sex = 1 if gender == 1
(16,703 missing values generated)

. replace sex = 2 if gender == 3
(16,703 real changes made)

. * 2002's standing/lying flag is sa08, 2005 and 2009 call it sa07a, coding 1 =
>  standing, 3 = lying down
. gen measure = "h" if sa08 == 1
(3,280 missing values generated)

. replace measure = "l" if sa08 == 3
(764 real changes made)

. gen str6 ageunit = "days"

. * This refers to fluid swelling and is a variable in WHO but not MxFLS so eve
> ryone gets a no
. gen oedema = "n"

. * Every is given equal weight
. gen sw = 1

. tempfile z_u5 z_5to19 z_all

. 
