. tostring folio, replace format(%08.0f)
folio was double now str8

. tostring ls, replace format(%02.0f)
ls was float now str2

. gen wave = 2002

. gen pid_link_canonical = folio + ls

. * Creating a variable for household fixed effects
. gen folio_canonical = folio

