. * We loop across all vars pretty much. We match in order to account for both 
> the yes/DK and the value. Then we account correctly for missing and non missi
> ng values. We take the median not the mean as we have outliers
. foreach f of varlist cs02?_?1 cs04?_*1 cs16?_1 cs18_1 cs22?_1 cs24?_1 cs27?_1
>  cs29_1 cs34a_11 cs34a_21 cs35a_11 cs35a_21 cs36a_11 cs36a_21 {
  2.     local v = substr("`f'", 1, strlen("`f'") - 1) + "2"
  3.     replace `v' = 0 if inlist(`v', 99, 999, 9999, 99999)
  4.     gen byte dk_tmp = (`f' == 8 | inlist(`v', 98, 998, 9998, 99998))
  5.     replace `v' = . if dk_tmp == 1
  6.     egen med_tmp = median(`v')
  7.     replace `v' = med_tmp if dk_tmp == 1
  8.     drop med_tmp dk_tmp
  9. }
