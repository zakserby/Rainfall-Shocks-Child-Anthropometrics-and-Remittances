        from master                        46  
        from using                          0  

    Matched                            32,123  
    -----------------------------------------

. 
. * Children are weighed and measured in Book S. We use the last dated Book S v
> isit as the measurement date, day = 15. Note: The 2002 s_conpor has no year a
> nd MxFLS-1 fieldwork was all in 2002
. preserve

.     use "$path/hh02dta_bs/s_conpor.dta", clear
(VERSION (ene 19))

.     keep folio secuencia mes

.     drop if !inrange(mes, 1, 12)
(25,618 observations deleted)

.     sort folio secuencia

.     by folio: keep if _n == _N
(4,704 observations deleted)

.     gen meas_date = mdy(mes, 15, 2002)

.     keep folio meas_date

.     tempfile measdate

.     save `measdate'
