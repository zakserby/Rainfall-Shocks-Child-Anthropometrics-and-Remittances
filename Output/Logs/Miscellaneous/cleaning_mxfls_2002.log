.     do "$scripts/Cleaning/Cleaning Script for MxFLS_2002_03.do"

. *******************************************************************
. * Cleaning Script and Initial Sumamry Statistics
. * Project: MS Thesis
. *******************************************************************
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global raw_mxfls "$root/Data/Raw/MxFLS"

. global raw_who "$root/Data/Raw/WHO_reference"

. global clean_mxfls "$root/Data/Cleaned/MxFLS"

. global clean_who "$root/Data/Cleaned/WHO_zscores"

. global clean_rain "$root/Data/Cleaned/Rainfall"

. global clean_banxico "$root/Data/Cleaned/Banxico"

. global out_sumstats "$root/Output/Tables"

. global out_regs "$root/Output/Regression_Estimates" 

. global out_logs "$root/Output/Logs"

. * Create the folders this project writes to. Note: capture skips quietly if a
>  folder already exist
. foreach d in "$root/Data" "$root/Data/Cleaned" "$clean_mxfls" "$clean_who" "$
> clean_rain" "$root/Output" "$out_sumstats" "$out_regs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. * Define base directory path
. global path "$raw_mxfls/hh02dta_all"

. 
. *******************************************************************
. * Health Biomarkers & Anthropometrics
. *******************************************************************
. 
. use "$path/hh02dta_bs/s_sa.dta", clear

. 
. * Note for now not differentiating between reported and measured I don't thin
> k
. rename sa03 age

. rename sa01 gender

. 
. * maybe different then other surveys bc this is reported for height and weigh
> t
. rename sa04_2 height_cm

. rename sa05_2 weight_kg_gr

. 
. * renamed sa17 whereas its sa16 in other surveys
. rename sa17_2 hemoglobin_g_dl

. rename ls00 ls

. 
. * We grab the child height and weight. Note that these variables are measured
>  (not self reported) and correspond to the other waves but are named slightly
>  different e.g. sa07_2 intsted of sa07_21
. rename sa07_2 child_height_cm

. rename sa09_2 child_weight_kg

. * In 2002 children under 2 had their measured weight written in sa10 instead 
> of sa09_2, no one has both so we fill it in
. replace child_weight_kg = sa10 if missing(child_weight_kg) & !missing(sa10)
(438 real changes made)

. 
. 
. * Child sex must come from the Book C roster, ls04, as sex disagrees across o
> ther books but the roster is correct.
. preserve

.     use "$path/hh02dta_bc/c_ls.dta", clear
(VERSION (ene 19))

.     keep folio ls ls04

.     tempfile roster_sex

.     save `roster_sex'
file /var/folders/8b/5tzzlj113bd9tswyt9lzxf580000gn/T//St01124.000002 saved
    as .dta format

. restore

. merge 1:1 folio ls using `roster_sex', keep(master match) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                            25
        from master                        25  
        from using                          0  

    Matched                            32,144  
    -----------------------------------------

. replace gender = ls04 if !missing(ls04)
(884 real changes made)

. drop ls04

. 
. *******************************************************************
. * Calcualting HAZ, WAZ, BMIZ
. *******************************************************************
. 
. * Grabbing the date
. rename sa02_1 bday

. rename sa02_2 bmonth

. rename sa02_3 byear

. 
. * This code purely is for the missing "day" observations. It imputes a bday i
> f we have both month and year.
. gen byte bday_imputed = !inrange(bday, 1, 31) & inrange(bmonth, 1, 12) & inra
> nge(byear, 1900, 2002)

. replace bday = 15 if bday_imputed == 1
(78 real changes made)

. 
. * This shows household visit/interview, same as 2005 and 2009 we use the last
>  Book C visit and set day=15 (mid-month). Also we use 2002 because the 2002 c
> _conpor has no year variable and MxFLS-1 fieldwork was all in 2002. Additiona
> lly we add a drop if for mes because most the rows empty. So can't take the l
> ast row like the other waves. 
. preserve

.     use "$path/hh02dta_bc/c_conpor.dta", clear
(VERSION (ene 19))

.     keep folio secuencia mes

.     drop if !inrange(mes, 1, 12)
(41,871 observations deleted)

.     sort folio secuencia

.     by folio: keep if _n == _N
(268 observations deleted)

.     gen int_date = mdy(mes, 15, 2002)

.     keep folio int_date

.     tempfile visitdate

.     save `visitdate'
file /var/folders/8b/5tzzlj113bd9tswyt9lzxf580000gn/T//St01124.000004 saved
    as .dta format

. restore

. merge m:1 folio using `visitdate', keep(master match) nogen

