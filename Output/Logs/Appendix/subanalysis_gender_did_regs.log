.     do "$scripts/Regressions/Subanalysis_Gender_DID_Regs.do"

. *******************************************************************
. * Subanalyses: DID by child sex 
. * Project: MS Thesis
. *******************************************************************
. 
. * Same DID, triple difference, event studies and robustness checks as DID_Reg
> s.do, run separately for boys and girls
. * Sex is the child's roster sex in 2005 "child_male_05", the same variable DI
> D_Regs.do uses as a control
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global clean_mxfls   "$root/Data/Cleaned/MxFLS"

. global clean_rain    "$root/Data/Cleaned/Rainfall"

. global out_regs      "$root/Output/Regression_Estimates"

. global out_figs      "$root/Output/Figures"

. global out_logs      "$root/Output/Logs"

. foreach d in "$root/Output" "$out_regs" "$out_figs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. foreach d in "$out_regs" "$out_logs" "$out_figs" {
  2.     foreach s in Main Appendix {
  3.         capture mkdir "`d'/`s'"
  4.     }
  5. }

. 
. * If the master already opened the log, the capture fails quietly and the mas
> ter keeps logging. If this file is run on its own, it opens the same log here
>  and closes it at the end, so the DID and the event study are always in the l
> og.
. capture log using "$out_logs/Appendix/subanalysis_gender_did_regs.log", repla
> ce text name(sub_gender_did)

. local own_log = (_rc == 0)

. 
. *******************************************************************
. * Load DID analysis data
. *******************************************************************
. 
. * Loading in data
. use "$clean_mxfls/mxfls_did_analysis.dta", clear
(ENNVIH-3 Libro s_sa)

. 
. label variable child_male_05 "Child is male (2005 roster), 1=Male 0=Female"

. 
. * Event study leads and lags: 2002 = -2 is the lead, 2005 = -1 is the referen
> ce, 2009 = 0
. gen lead_2_treat = treat2009 * (year == 2002)
(25,453 missing values generated)

. gen lag_0_treat  = treat2009 * (year == 2009)
(25,453 missing values generated)

. gen lead_2_remit = remittance_hh_02 * (year == 2002)
(44,004 missing values generated)

. gen lag_0_remit  = remittance_hh_02 * (year == 2009)
(44,004 missing values generated)

. gen lead_2_ddd   = treat2009 * remittance_hh_02 * (year == 2002)
(44,016 missing values generated)

. gen lag_0_ddd    = treat2009 * remittance_hh_02 * (year == 2009)
(44,016 missing values generated)

. 
. * IMPORTANT NOTE IS THIS IS JUST A ROBUSTNESS CHECK, IT DROPS THE SAMPLE SIZE
>  SIGNIFICANTLY 
. 
. * We run the same event study as above but only children measured in all thre
> e waves with the outcome nonmissing in each. This way the 2002 lead and the 2
> 009 coefficient come from the same children
. foreach v in haz waz bmiz {
  2.     bysort pid_link_canonical: egen n3_`v' = total(e_`v' == 1 & !missing(`
> v'))
  3.     gen e_`v'_all3 = (e_`v' == 1 & !missing(`v') & n3_`v' == 3)
  4. }

. 
. *******************************************************************
. * Fixed Effects & Controls
. *******************************************************************
. 
. * Same as DID_Regs do file, except child_male_05_post is taken out of control
> s05 because sex does not vary within a subsample
. global FE_month "pid_link_canonical int_ym"

. global did_controls "drought2005_post drought2006_post drought2007_post droug
> ht2008_post"

. global controls02 "dwell_electricity_02_post dwell_floor_good_02_post dwell_r
> oof_good_02_post dwell_ventilation_good_02_post rooms_per_person_02_post ln_p
> c_expend_month_02_post rural_02_post"

. global controls05 "mother_height_cm_05_post mother_edu_years_05_post mother_a
> ge_at_birth_05_post mother_employed_05_post fully_vaccinated_05_post"

. global controls05_birth "father_height_cm_05_post father_edu_years_05_post fa
> ther_age_at_birth_05_post father_employed_05_post birth_order_05_post oldest_
> child_05_post birth_weight_kg_05_post delivered_home_05_post predominant_brea
> stfed_05_post iron_pregnancy_05_post premature_05_post"

. 
. * reghdfe and its dependencies, same as DID_Regs.do
. capture which reghdfe

. if _rc ssc install reghdfe

. capture which ftools

. if _rc ssc install ftools

. capture which require

. if _rc ssc install require

. 
. *******************************************************************
. * Regressions by sex
. *******************************************************************
. 
. * Everything below runs once for boys and once for girls. 
. * Note that: Figures and event study files get _boys or _girls at the end of 
> the name
. foreach s in boys girls {
  2. if "`s'" == "boys"  local sex "child_male_05 == 1"
  3. if "`s'" == "girls" local sex "child_male_05 == 0"
  4. di as result _n "==================== `s' ===================="
  5. 
. *******************************************************************
. * DID regressions: 2009 drought
. *******************************************************************
. 
. * Now we do the regressions again splitting on sex 
. foreach v in haz waz bmiz {
  6.     * Model 1: Basic DID
.     reghdfe `v' treat_post if s_`v' == 1 & `sex', absorb($FE_month) vce(clust
> er cvegeo05)
  7.     * Model 2: DID controlling for the other droughts in the window
.     reghdfe `v' treat_post $did_controls if s_`v' == 1 & `sex', absorb($FE_mo
> nth) vce(cluster cvegeo05)
  8.     * Model 3: DID with baseline 2002 household controls and 2005 child an
> d mother controls
.     reghdfe `v' treat_post $did_controls $controls02 $controls05 if s_`v' == 
> 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
  9.         * Model 4: Model 3 with the father and birth controls, smaller sam
> ple
.     reghdfe `v' treat_post $did_controls $controls02 $controls05 $controls05_
> birth if s_`v' == 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
 10.     * Model 5: Triple difference, does 2002 remittance receipt buffer the 
> drought
.     reghdfe `v' treat_post remittance_hh_02_post treat_post_remit02 $did_cont
> rols $controls02 $controls05 if s_`v' == 1 & `sex', absorb($FE_month) vce(clu
> ster cvegeo05)
 11.     * Total drought effect for children in 2002 remittance households
.     lincom treat_post + treat_post_remit02
 12. }
 13. 
. *******************************************************************
. * Parallel trends and event study
. *******************************************************************
. 
. * Parallel trends graph and event study split on sex
. foreach v in haz waz bmiz {
 14.     preserve
 15.     keep if e_`v' == 1 & `sex'
 16.     collapse (mean) `v', by(treat2009 year)
 17.     twoway ///
>         (connected `v' year if treat2009 == 0, mc(navy) lc(navy) ms(O)) ///
>         (connected `v' year if treat2009 == 1, mc(cranberry) lc(cranberry) ms
> (T)), ///
>         xline(2009, lp(dash) lc(black)) ///
>         xlabel(2002 2005 2009) ///
>         legend(order(1 "Control" 2 "Treated (2009 drought)") pos(6) row(1)) /
> //
>         xtitle("Wave") ytitle("Mean `v'") ///
>         title("Mean `v' by wave, treated vs control, `s'")
 18.     graph export "$out_figs/Appendix/trends_`v'_`s'.png", replace
 19.     restore
 20. }
 21. 
. * Event-study TWFE DID
. foreach v in haz waz bmiz {
 22.     reghdfe `v' lead_2_treat lag_0_treat if e_`v' == 1 & `sex', absorb($FE
> _month) vce(cluster cvegeo05)
 23.     test lead_2_treat
 24. 
.     preserve
 25.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_`v'_`s'.dta", replace
 26.     post handle (-2) (_b[lead_2_treat]) (_se[lead_2_treat]) (_b[lead_2_tre
> at] - 1.96*_se[lead_2_treat]) (_b[lead_2_treat] + 1.96*_se[lead_2_treat])
 27.     post handle (-1) (0) (0) (0) (0)
 28.     post handle (0) (_b[lag_0_treat]) (_se[lag_0_treat]) (_b[lag_0_treat] 
> - 1.96*_se[lag_0_treat]) (_b[lag_0_treat] + 1.96*_se[lag_0_treat])
 29.     postclose handle
 30. 
.     use "$out_regs/Appendix/es_`v'_`s'.dta", clear
 31.     sort etime
 32.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("Event study: `v', `s'") legend(off)
 33.     graph export "$out_figs/Appendix/event_study_`v'_`s'.png", replace
 34.     restore
 35. }
 36. 
. * c. Triple-difference event study
. foreach v in haz waz bmiz {
 37.     reghdfe `v' lead_2_ddd lag_0_ddd lead_2_treat lag_0_treat lead_2_remit
>  lag_0_remit if e_`v' == 1 & !missing(remittance_hh_02) & `sex', absorb($FE_m
> onth) vce(cluster cvegeo05)
 38.     test lead_2_ddd
 39.     lincom lag_0_treat + lag_0_ddd
 40. 
.     preserve
 41.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_ddd_`v'_`s'.dta", replace
 42.     post handle (-2) (_b[lead_2_ddd]) (_se[lead_2_ddd]) (_b[lead_2_ddd] - 
> 1.96*_se[lead_2_ddd]) (_b[lead_2_ddd] + 1.96*_se[lead_2_ddd])
 43.     post handle (-1) (0) (0) (0) (0)
 44.     post handle (0) (_b[lag_0_ddd]) (_se[lag_0_ddd]) (_b[lag_0_ddd] - 1.96
> *_se[lag_0_ddd]) (_b[lag_0_ddd] + 1.96*_se[lag_0_ddd])
 45.     postclose handle
 46. 
.     use "$out_regs/Appendix/es_ddd_`v'_`s'.dta", clear
 47.     sort etime
 48.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("DDD event study (drought x 2002 remittances): `v', `s'") legen
> d(off)
 49.     graph export "$out_figs/Appendix/event_study_ddd_`v'_`s'.png", replace
 50.     restore
 51. }
 52. 
. *******************************************************************
. * Robustness tests
. *******************************************************************
. 
. *******************************************************************
. * a. Children measured in all three waves
. *******************************************************************
. 
. foreach v in haz waz bmiz {
 53.     reghdfe `v' treat_post if s_`v' == 1 & e_`v'_all3 == 1 & `sex', absorb
> ($FE_month) vce(cluster cvegeo05)
 54.     reghdfe `v' treat_post $did_controls if s_`v' == 1 & e_`v'_all3 == 1 &
>  `sex', absorb($FE_month) vce(cluster cvegeo05)
 55.     reghdfe `v' treat_post $did_controls $controls02 $controls05 if s_`v' 
> == 1 & e_`v'_all3 == 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
 56.     reghdfe `v' treat_post $did_controls $controls02 $controls05 $controls
> 05_birth if s_`v' == 1 & e_`v'_all3 == 1 & `sex', absorb($FE_month) vce(clust
> er cvegeo05)
 57.     reghdfe `v' treat_post remittance_hh_02_post treat_post_remit02 $did_c
> ontrols $controls02 $controls05 if s_`v' == 1 & e_`v'_all3 == 1 & `sex', abso
> rb($FE_month) vce(cluster cvegeo05)
 58.     lincom treat_post + treat_post_remit02
 59. }
